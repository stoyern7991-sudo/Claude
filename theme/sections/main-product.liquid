{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: product.id
-%}

<div class="product-page" data-product-page data-product-id="{{ product.id }}" data-product-handle="{{ product.handle }}">
  <div class="container">
    <div class="product-page__inner">

      {%- comment -%} Media Gallery {%- endcomment -%}
      <div class="product-page__gallery">
        {%- render 'media-gallery', product: product -%}
      </div>

      {%- comment -%} Product Info {%- endcomment -%}
      <div class="product-page__info">
        {%- render 'breadcrumbs' -%}

        {%- if product.vendor != blank and section.settings.show_vendor -%}
          <p class="product-page__vendor label">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="product-page__title">{{ product.title }}</h1>

        {%- comment -%} Judge.me stars {%- endcomment -%}
        {%- render 'judgeme-stars', product: product -%}

        <div class="product-page__price js-product-price">
          {%- render 'price', product: product -%}
        </div>

        {%- comment -%} Product form {%- endcomment -%}
        {%- form 'product', product, id: form_id, data-product-form: '' -%}
          {%- render 'variant-picker', product: product, form_id: form_id -%}

          {%- comment -%} Quantity {%- endcomment -%}
          {%- if section.settings.show_quantity -%}
            <div class="product-page__quantity">
              <label for="qty-{{ product.id }}" class="product-page__qty-label">Quantity</label>
              <div class="qty-selector">
                <button type="button" class="qty-selector__btn" onclick="var i=document.getElementById('qty-{{ product.id }}');i.value=Math.max(1,parseInt(i.value)-1)">−</button>
                <input
                  id="qty-{{ product.id }}"
                  class="qty-selector__input"
                  type="number"
                  name="quantity"
                  value="1"
                  min="1"
                >
                <button type="button" class="qty-selector__btn" onclick="var i=document.getElementById('qty-{{ product.id }}');i.value=parseInt(i.value)+1">+</button>
              </div>
            </div>
          {%- else -%}
            <input type="hidden" name="quantity" value="1">
          {%- endif -%}

          {%- comment -%} ATC button {%- endcomment -%}
          <div class="product-page__atc">
            <button
              type="submit"
              class="btn btn--primary btn--full js-atc-btn"
              data-variant-id="{{ current_variant.id }}"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {%- if current_variant.available -%}
                Add to Cart
              {%- else -%}
                Sold Out
              {%- endif -%}
            </button>
          </div>
        {%- endform -%}

        {%- comment -%} Trust badges / Shipping blurb {%- endcomment -%}
        {%- if section.settings.shipping_text != blank -%}
          <p class="product-page__shipping-blurb">
            {{ section.settings.shipping_text | escape }}
          </p>
        {%- endif -%}

        {%- comment -%} Description accordion {%- endcomment -%}
        {%- if product.description != blank -%}
          <div class="product-page__accordion">
            <details class="accordion" open>
              <summary class="accordion__summary">
                <span>Product Details</span>
                {%- render 'icon-caret' -%}
              </summary>
              <div class="accordion__body rte">
                {{ product.description }}
              </div>
            </details>

            {%- if section.settings.shipping_policy != blank -%}
              <details class="accordion">
                <summary class="accordion__summary">
                  <span>Shipping &amp; Returns</span>
                  {%- render 'icon-caret' -%}
                </summary>
                <div class="accordion__body rte">
                  {{ section.settings.shipping_policy }}
                </div>
              </details>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>

  {%- render 'sticky-atc', product: product, form_id: form_id -%}
</div>

<script src="{{ 'product.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product Information",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Shipping / trust badge text",
      "default": "Free shipping on orders over $75 · Easy returns"
    },
    {
      "type": "richtext",
      "id": "shipping_policy",
      "label": "Shipping & returns policy text"
    }
  ]
}
{% endschema %}

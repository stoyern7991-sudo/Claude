{%- style -%}
  .drop {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: clamp(500px, 70vh, 800px);
  }
  .drop__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(3rem, 6vw, 7rem) clamp(2rem, 5vw, 6rem);
    background: var(--color-cream-deep);
    order: {% if section.settings.image_side == 'left' %}2{% else %}1{% endif %};
  }
  .drop__text-eye {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-sand);
    margin-bottom: 1.5rem;
    display: block;
  }
  .drop__text h2 {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(2.5rem, 4vw, 4.25rem);
    line-height: 1.15;
    color: var(--color-ink);
    margin: 0 0 1.5rem;
    font-weight: 500;
    white-space: pre-line;
  }
  .drop__text p {
    font-size: 1rem;
    color: var(--color-muted);
    line-height: 1.8;
    font-weight: 300;
    max-width: 36ch;
    margin: 0 0 2.5rem;
  }
  .drop__ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .drop__img {
    position: relative;
    overflow: hidden;
    order: {% if section.settings.image_side == 'left' %}1{% else %}2{% endif %};
  }
  .drop__img-inner {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center {{ section.settings.focal_point | default: '50%' }};
    transition: transform 1.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .drop:hover .drop__img-inner {
    transform: scale(1.04);
  }
  .drop__img-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(150deg, var(--color-navy-mid), var(--color-sage));
  }
  @media (max-width: 800px) {
    .drop {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .drop__text { order: 2; }
    .drop__img { order: 1; min-height: 70vw; }
  }
{%- endstyle -%}

<div class="drop reveal" id="drop-{{ section.id }}">
  <div class="drop__text">
    {%- if section.settings.eyebrow != blank -%}
      <span class="drop__text-eye">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.copy != blank -%}
      <p>{{ section.settings.copy | escape }}</p>
    {%- endif -%}
    <div class="drop__ctas">
      {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
        <a href="{{ section.settings.cta_url }}" class="btn btn--primary">
          {{ section.settings.cta_label | escape }}
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.cta_2_label != blank and section.settings.cta_2_url != blank -%}
        <a href="{{ section.settings.cta_2_url }}" class="btn btn--secondary">
          {{ section.settings.cta_2_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="drop__img">
    {%- if section.settings.image != blank -%}
      <img
        class="drop__img-inner"
        src="{{ section.settings.image | image_url: width: 1400 }}"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        loading="lazy"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      >
    {%- else -%}
      <div class="drop__img-placeholder"></div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Drop Feature",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow / drop name",
      "default": "Summer Drop · 2025"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "The Tidal\nCollection"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Body copy",
      "default": "Woven from deadstock cotton and sea-salt-tested on the Outer Banks. Limited run. Ships Friday."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary CTA label",
      "default": "Shop the Drop"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "cta_2_label",
      "label": "Secondary CTA label",
      "default": "Read the story"
    },
    {
      "type": "url",
      "id": "cta_2_url",
      "label": "Secondary CTA link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Campaign image"
    },
    {
      "type": "select",
      "id": "focal_point",
      "label": "Image focal point (vertical)",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "40%", "label": "Upper" },
        { "value": "50%", "label": "Center" },
        { "value": "60%", "label": "Lower" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "50%"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right (text left)" },
        { "value": "left", "label": "Left (text right)" }
      ],
      "default": "right"
    }
  ],
  "presets": [
    {
      "name": "Drop Feature"
    }
  ]
}
{% endschema %}

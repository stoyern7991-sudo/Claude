<section class="location-section section-padding {{ section.settings.background }}" id="loc-{{ section.id }}">
  <div class="container">
    <div class="location__inner">
      {%- if section.settings.image != blank -%}
        <div class="location__media reveal-left">
          <div class="location__img-frame">
            <img
              src="{{ section.settings.image | image_url: width: 800 }}"
              alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
              class="location__img"
              width="800"
              height="{{ 800 | divided_by: section.settings.image.aspect_ratio | ceil }}"
              loading="lazy"
            >
          </div>
        </div>
      {%- endif -%}

      <div class="location__content reveal-right">
        {%- if section.settings.eyebrow != blank -%}
          <p class="section-header__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="location__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.address != blank -%}
          <address class="location__address">{{ section.settings.address | newline_to_br }}</address>
        {%- endif -%}
        {%- if section.settings.hours != blank -%}
          <div class="location__hours">
            <p class="label">Store Hours</p>
            <p>{{ section.settings.hours | newline_to_br }}</p>
          </div>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <a href="tel:{{ section.settings.phone }}" class="location__phone">{{ section.settings.phone }}</a>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a
            href="{{ section.settings.cta_url | default: '#' }}"
            class="btn btn--primary"
            {% if section.settings.cta_url contains 'maps' or section.settings.cta_url contains 'google' %}
              target="_blank" rel="noopener"
            {% endif %}
          >
            {{ section.settings.cta_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Location / Visit Us",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Store image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Find Us"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Come Visit Us!"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "211 South Broad St\nEdenton, NC 27932"
    },
    {
      "type": "textarea",
      "id": "hours",
      "label": "Store hours",
      "default": "Mon–Sat: 10am–6pm\nSun: 12pm–5pm"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Get Directions"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL (Google Maps link)"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "bg-default", "label": "Default" },
        { "value": "bg-alt", "label": "Warm sand" },
        { "value": "bg-surface", "label": "Sage" },
        { "value": "bg-navy", "label": "Navy (dark)" }
      ],
      "default": "bg-alt"
    }
  ],
  "presets": [
    {
      "name": "Location",
      "settings": {
        "eyebrow": "Find Us",
        "heading": "Come Visit Us!"
      }
    }
  ]
}
{% endschema %}

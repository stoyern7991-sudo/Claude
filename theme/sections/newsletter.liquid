<section class="newsletter section-padding {{ section.settings.background }}" id="nl-{{ section.id }}">
  <div class="container container--narrow">
    <div class="newsletter__inner text-center reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="section-header__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="newsletter__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="newsletter__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- form 'customer', id: 'newsletter-form-{{ section.id }}', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="newsletter__success">{{ 'newsletter.success' | t | default: 'Thanks for subscribing!' }}</p>
        {%- else -%}
          <div class="newsletter__input-group">
            <label for="newsletter-email-{{ section.id }}" class="visually-hidden">Email address</label>
            <input
              id="newsletter-email-{{ section.id }}"
              type="email"
              name="contact[email]"
              class="form-input newsletter__input"
              placeholder="{{ section.settings.input_placeholder | default: 'Your email address' }}"
              required
              autocomplete="email"
            >
            <button type="submit" class="btn btn--primary newsletter__submit">
              {{ section.settings.button_label | default: 'Subscribe' }}
            </button>
          </div>
          {%- if form.errors -%}
            <p class="form-error">{{ form.errors.translated_fields | join: ', ' }} — please try again.</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.disclaimer != blank -%}
        <p class="newsletter__disclaimer">{{ section.settings.disclaimer | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Join the Community"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in the Loop"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "New arrivals, exclusive deals, and coastal style inspiration — straight to your inbox."
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Input placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer text",
      "default": "No spam, ever. Unsubscribe any time."
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "bg-default", "label": "Default" },
        { "value": "bg-surface", "label": "Sage" },
        { "value": "bg-alt", "label": "Warm sand" },
        { "value": "bg-navy", "label": "Navy (dark)" }
      ],
      "default": "bg-surface"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}

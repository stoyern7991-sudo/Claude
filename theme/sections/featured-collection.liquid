{%- liquid
  assign cols_desktop = section.settings.columns_desktop | default: 4
  assign limit = section.settings.product_limit | default: 8
-%}

<section
  class="featured-collection section-padding quick-filter-section {{ section.settings.background }}"
  id="fc-{{ section.id }}"
  data-limit="{{ limit }}"
  data-cols="{{ cols_desktop }}"
>
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="section-header{% if section.settings.heading_align == 'center' %} section-header--centered{% endif %} reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="section-header__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-header__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section-header__description">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Tab buttons {%- endcomment -%}
    {%- if section.blocks.size > 1 -%}
      <div class="qf-tabs reveal" role="tablist" aria-label="{{ section.settings.heading | escape }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'collection_tab' and block.settings.collection != blank -%}
            <button
              class="qf-tab"
              role="tab"
              data-collection="{{ block.settings.collection.handle }}"
              aria-selected="false"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label | default: block.settings.collection.title }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- elsif section.blocks.size == 1 -%}
      {%- comment -%} Single collection — load directly via Liquid {%- endcomment -%}
      {%- assign single_block = section.blocks.first -%}
      {%- if single_block.settings.collection != blank -%}
        <div style="display:none;" class="qf-tabs" data-single="true">
          <button
            class="qf-tab"
            role="tab"
            data-collection="{{ single_block.settings.collection.handle }}"
            aria-selected="true"
          >
            {{ single_block.settings.collection.title }}
          </button>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} Loading indicator {%- endcomment -%}
    <div class="qf-loading loading-spinner" hidden>
      <div class="loading-spinner__ring"></div>
    </div>

    {%- comment -%} Product grid (populated by JS) {%- endcomment -%}
    <div
      class="qf-grid product-grid product-grid--{{ cols_desktop }}-col reveal-stagger"
      style="grid-template-columns: repeat({{ cols_desktop }}, 1fr);"
    >
      {%- comment -%} JS will populate this; show Liquid-rendered products server-side for first tab {%- endcomment -%}
      {%- if section.blocks.first.settings.collection != blank -%}
        {%- for product in section.blocks.first.settings.collection.products limit: limit -%}
          {%- render 'product-card', product: product, show_vendor: section.settings.show_vendor -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and section.blocks.first.settings.collection != blank -%}
      <div class="featured-collection__footer reveal" style="text-align: center; margin-top: var(--space-10);">
        <a href="{{ section.blocks.first.settings.collection.url }}" class="btn btn--secondary">
          {{ section.settings.view_all_label | default: 'View All' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'quick-filter.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 4,
      "max": 12,
      "step": 2,
      "label": "Products per tab",
      "default": 8
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "'View All' button text",
      "default": "View All"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "bg-default", "label": "Default" },
        { "value": "bg-alt", "label": "Warm sand" },
        { "value": "bg-surface", "label": "Sage" },
        { "value": "bg-white", "label": "White" }
      ],
      "default": "bg-default"
    }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "Collection Tab",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Tab label (leave blank to use collection name)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collection",
      "blocks": [
        { "type": "collection_tab" }
      ]
    }
  ]
}
{% endschema %}

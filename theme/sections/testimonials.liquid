{%- style -%}
  .trev {
    padding-block: clamp(4rem, 8vw, 8rem);
    padding-inline: var(--section-padding-x);
    background: {{ section.settings.background_color | default: 'var(--color-cream-mid)' }};
  }
  .trev__head {
    text-align: center;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    max-width: var(--container-wide);
    margin-inline: auto;
  }
  .trev__eye {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-sage);
    display: block;
    margin-bottom: 1rem;
  }
  .trev__head h2 {
    font-family: var(--font-body);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 300;
    color: var(--color-ink);
    letter-spacing: -0.01em;
    margin: 0;
  }
  .trev__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2px;
    max-width: var(--container-wide);
    margin-inline: auto;
    background: var(--color-faint);
  }
  .trev__card {
    background: {{ section.settings.background_color | default: 'var(--color-cream-mid)' }};
    padding: 2.5rem 2rem;
  }
  .trev__stars {
    display: flex;
    gap: 3px;
    margin-bottom: 1.25rem;
  }
  .trev__star {
    color: var(--color-aqua);
    font-size: 0.9rem;
    line-height: 1;
  }
  .trev__star.is-empty {
    color: var(--color-faint);
  }
  .trev__quote {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-ink);
    margin: 0 0 1.5rem;
  }
  .trev__author {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
    font-style: normal;
    display: block;
  }
  .trev__app {
    max-width: var(--container-wide);
    margin-inline: auto;
  }
{%- endstyle -%}

<section class="trev" id="trev-{{ section.id }}">
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
    <div class="trev__head reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="trev__eye">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- assign app_blocks = section.blocks | where: 'type', '@app' -%}
  {%- if app_blocks.size > 0 -%}
    <div class="trev__app reveal">
      {%- for block in app_blocks -%}
        <div {{ block.shopify_attributes }}>{% render block %}</div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- assign manual_reviews = section.blocks | where: 'type', 'review' -%}
  {%- if manual_reviews.size > 0 -%}
    <div class="trev__grid reveal">
      {%- for block in manual_reviews -%}
        <div class="trev__card" {{ block.shopify_attributes }}>
          <div class="trev__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
            {%- for i in (1..5) -%}
              <span class="trev__star{% if i > block.settings.rating %} is-empty{% endif %}" aria-hidden="true">★</span>
            {%- endfor -%}
          </div>
          {%- if block.settings.text != blank -%}
            <blockquote class="trev__quote">"{{ block.settings.text | escape }}"</blockquote>
          {%- endif -%}
          {%- if block.settings.author != blank -%}
            <cite class="trev__author">{{ block.settings.author | escape }}</cite>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Testimonials / Reviews",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "From the community"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real people, real salt air"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Stars",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text",
          "default": "Best coastal brand I've found. The quality is next level and it actually fits."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer name",
          "default": "Sarah M., Kitty Hawk NC"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}

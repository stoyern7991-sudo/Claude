<section class="testimonials section-padding {{ section.settings.background }}" id="tr-{{ section.id }}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-header section-header--centered reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="section-header__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="section-header__title">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    {%- comment -%} Judge.me app embed — loaded via app block {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="testimonials__app-block" {{ block.shopify_attributes }}>
            {% render block %}
          </div>
        {%- elsif block.type == 'review' -%}
          {%- comment -%} Manual review fallback {%- endcomment -%}
          {%- unless forloop.first -%}{%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- comment -%} Manual review cards fallback {%- endcomment -%}
    {%- assign manual_reviews = section.blocks | where: 'type', 'review' -%}
    {%- if manual_reviews.size > 0 -%}
      <div class="testimonials__grid reveal-stagger">
        {%- for block in manual_reviews -%}
          <div class="testimonial-card" {{ block.shopify_attributes }}>
            <div class="testimonial-card__stars">
              {%- for i in (1..5) -%}
                <span class="testimonial-card__star{% if i > block.settings.rating %} is-empty{% endif %}">★</span>
              {%- endfor -%}
            </div>
            {%- if block.settings.text != blank -%}
              <blockquote class="testimonial-card__text">"{{ block.settings.text | escape }}"</blockquote>
            {%- endif -%}
            {%- if block.settings.author != blank -%}
              <cite class="testimonial-card__author">— {{ block.settings.author | escape }}</cite>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials / Reviews",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Customer Love"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "bg-default", "label": "Default" },
        { "value": "bg-navy", "label": "Navy (dark)" },
        { "value": "bg-alt", "label": "Warm sand" }
      ],
      "default": "bg-navy"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "review",
      "name": "Review (manual)",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text",
          "default": "Absolutely love this store! Great quality and fast shipping."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer name",
          "default": "Happy Customer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}

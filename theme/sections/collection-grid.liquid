<section class="collection-grid section-padding {{ section.settings.background }}" id="cg-{{ section.id }}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-header{% if section.settings.heading_align == 'center' %} section-header--centered{% endif %} reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="section-header__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="section-header__title">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div
      class="collection-grid__grid reveal-stagger"
      style="--cg-cols: {{ section.settings.columns_desktop }};"
    >
      {%- for block in section.blocks -%}
        {%- if block.type == 'collection' -%}
          {%- liquid
            assign col = block.settings.collection
            assign label = block.settings.label | default: col.title
            assign img = block.settings.image | default: col.featured_image
          -%}
          <a
            class="collection-card hover-zoom"
            href="{{ col.url | default: block.settings.url | default: '#' }}"
            {{ block.shopify_attributes }}
          >
            <div class="collection-card__media">
              {%- if img != blank -%}
                <img
                  src="{{ img | image_url: width: 800 }}"
                  alt="{{ img.alt | default: label | escape }}"
                  width="800"
                  height="{{ 800 | divided_by: img.aspect_ratio | ceil }}"
                  loading="lazy"
                  class="collection-card__img"
                >
              {%- else -%}
                <div class="collection-card__placeholder skeleton" style="aspect-ratio:1/1;"></div>
              {%- endif -%}
            </div>
            <div class="collection-card__overlay">
              <span class="collection-card__label">{{ label }}</span>
              <span class="collection-card__arrow">{%- render 'icon-arrow-right' -%}</span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "6", "label": "6" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "bg-default", "label": "Default" },
        { "value": "bg-alt", "label": "Warm sand" },
        { "value": "bg-navy", "label": "Navy (dark)" },
        { "value": "bg-white", "label": "White" }
      ],
      "default": "bg-default"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "limit": 8,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image (overrides collection image)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label (overrides collection name)"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Custom URL (if no collection selected)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Grid",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}

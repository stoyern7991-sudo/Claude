{%- liquid
  assign tab_color        = section.settings.tab_color
  assign tab_active_color = section.settings.tab_active_color
  assign tab_bg_color     = section.settings.tab_bg_color
  assign tab_bg_active    = section.settings.tab_bg_active
  assign tab_hover_color  = section.settings.tab_hover_color
  assign tab_bg_hover     = section.settings.tab_bg_hover
  assign tabs_gap         = section.settings.tabs_gap
  assign tab_padding_v    = section.settings.tab_padding_v
  assign tab_padding_h    = section.settings.tab_padding_h
  assign tab_font_size    = section.settings.tab_font_size
  assign tab_font_size_mb = section.settings.tab_font_size_mobile
  assign columns          = section.settings.columns
  assign columns_gap      = section.settings.columns_gap
  assign mobile_card_size = section.settings.mobile_card_size
  assign products_show    = section.settings.products_show
  assign button_text      = section.settings.button_text
  assign collections      = section.settings.collections
-%}

{%- style -%}
  .fct-wrap-{{ section.id }} {
    display: flex;
    flex-direction: column;
  }

  .fct-header-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 26px;
    gap: 12px;
  }

  .fct-tablist-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: {{ tabs_gap }}px;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    flex-wrap: nowrap;
    flex-shrink: 1;
    min-width: 0;
  }
  .fct-tablist-{{ section.id }}::-webkit-scrollbar { display: none; }

  .fct-tab-{{ section.id }} {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: {{ tab_font_size_mb }}px;
    color: {{ tab_color }};
    background: {{ tab_bg_color }};
    border: none;
    cursor: pointer;
    padding: {{ tab_padding_v }}px {{ tab_padding_h }}px;
    white-space: nowrap;
    transition: color 0.2s ease, background 0.2s ease;
    text-decoration: none;
    display: inline-block;
    line-height: 1.4;
    border-radius: 0;
    flex-shrink: 0;
  }
  .fct-tab-{{ section.id }}:hover {
    color: {{ tab_hover_color }};
    background: {{ tab_bg_hover }};
  }
  .fct-tab-{{ section.id }}[aria-selected="true"] {
    color: {{ tab_active_color }};
    background: {{ tab_bg_active }};
  }

  .fct-see-more-{{ section.id }} {
    flex-shrink: 0;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    color: currentColor;
    white-space: nowrap;
  }

  .fct-carousel-{{ section.id }} {
    margin-top: 0;
  }

  @media screen and (min-width: 750px) {
    .fct-header-{{ section.id }} {
      margin-bottom: 26px;
    }
    .fct-tab-{{ section.id }} {
      font-size: {{ tab_font_size }}px;
    }
  }
{%- endstyle -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<featured-collection-tabs
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    spacing-style
    fct-wrap-{{ section.id }}
  "
  style="{% render 'spacing-style', settings: section.settings %}"
  data-section-id="{{ section.id }}"
>

  {%- comment -%} Header: tabs + see-more link {%- endcomment -%}
  <div class="fct-header-{{ section.id }}">
    <div class="fct-tablist-{{ section.id }}" role="tablist" aria-label="{{ section.settings.heading | default: 'Collections' | escape }}">
      {%- assign fct_first_tab = true -%}
      {%- for tab_col in collections -%}
        {%- assign tab_id = section.id | append: '-tab-' | append: forloop.index -%}
        <button
          class="fct-tab-{{ section.id }}"
          role="tab"
          aria-selected="{{ fct_first_tab | json }}"
          aria-controls="fct-panel-{{ tab_id }}"
          data-fct-tab="{{ tab_id }}"
          id="fct-tab-{{ tab_id }}"
        >
          {{- tab_col.title -}}
        </button>
        {%- assign fct_first_tab = false -%}
      {%- endfor -%}
    </div>

    {%- if button_text != blank -%}
      {%- assign fct_first_col = collections | first -%}
      <a
        href="{{ fct_first_col.url }}"
        class="fct-see-more-{{ section.id }}"
        data-fct-see-more
        {%- if fct_first_col == blank %} hidden{%- endif -%}
      >
        {{- button_text -}}
      </a>
    {%- endif -%}
  </div>

  {%- comment -%} Tab panels — one per collection {%- endcomment -%}
  {%- assign fct_first_panel = true -%}
  {%- for tab_col in collections -%}
    {%- assign tab_id       = section.id | append: '-tab-' | append: forloop.index -%}
    {%- assign carousel_ref = 'fct' | append: section.id | append: forloop.index -%}

    <div
      id="fct-panel-{{ tab_id }}"
      role="tabpanel"
      aria-labelledby="fct-tab-{{ tab_id }}"
      data-fct-panel="{{ tab_id }}"
      data-fct-url="{{ tab_col.url }}"
      {%- unless fct_first_panel %} hidden{%- endunless -%}
    >
      {%- capture list_items -%}
        {%- if tab_col != blank and shop.products_count > 0 -%}
          {%- for product in tab_col.products limit: products_show -%}
            <div class="resource-list__item">
              {%- # theme-check-disable UniqueStaticBlockId -%}
                {%- content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product -%}
              {%- # theme-check-enable UniqueStaticBlockId -%}
            </div>
            {%- unless forloop.last -%}<!--@list/split-->{%- endunless -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..products_show) -%}
            <div class="resource-list__item">
              {%- # theme-check-disable UniqueStaticBlockId -%}
                {%- content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null -%}
              {%- # theme-check-enable UniqueStaticBlockId -%}
            </div>
            {%- unless forloop.last -%}<!--@list/split-->{%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endcapture -%}

      {%- liquid
        assign list_items_array = list_items | strip | split: '<!--@list/split-->'
      -%}

      <div
        class="resource-list resource-list__carousel force-full-width fct-carousel-{{ section.id }}"
        style="
          --resource-list-column-gap-desktop: {{ columns_gap }}px;
          --column-count: {{ columns }};
          --column-count-mobile: 1;
          --mobile-card-size: {{ mobile_card_size }};
        "
      >
        {%- render 'resource-list-carousel',
          ref: carousel_ref,
          slides: list_items_array,
          slide_count: products_show,
          settings: section.settings,
          slide_width_max: '450px'
        -%}
      </div>
    </div>
    {%- assign fct_first_panel = false -%}
  {%- endfor -%}

</featured-collection-tabs>

<script type="module">
  {
    const TAG = 'featured-collection-tabs';
    if (!customElements.get(TAG)) {
      customElements.define(TAG, class extends HTMLElement {
        connectedCallback() {
          this._tabs    = [...this.querySelectorAll('[data-fct-tab]')];
          this._panels  = [...this.querySelectorAll('[data-fct-panel]')];
          this._seeMore = this.querySelector('[data-fct-see-more]');
          this._tabs.forEach(t => t.addEventListener('click', () => this._activate(t)));
        }

        _activate(tab) {
          const id = tab.dataset.fctTab;

          this._tabs.forEach(t => {
            t.setAttribute('aria-selected', String(t === tab));
          });

          this._panels.forEach(p => {
            const isActive = p.dataset.fctPanel === id;
            p.hidden = !isActive;
            if (isActive && this._seeMore) {
              const url = p.dataset.fctUrl;
              this._seeMore.href = url;
              this._seeMore.hidden = !url;
            }
          });
        }
      });
    }
  }
</script>

{% schema %}
{
  "name": "Collection Tabs",
  "class": "ui-test-featured-collection-tabs",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 8
    },
    {
      "type": "range",
      "id": "products_show",
      "label": "Products to show per tab",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "See More"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_card_size",
      "label": "Mobile visible cards",
      "options": [
        { "value": "70cqw",  "label": "~3 cards" },
        { "value": "80cqw",  "label": "~2.5 cards" },
        { "value": "90cqw",  "label": "~1 card + peek" },
        { "value": "100cqw", "label": "1 card (full width)" }
      ],
      "default": "90cqw"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Gap between cards",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Carousel arrows"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "Arrow style",
      "options": [
        { "value": "none",    "label": "None" },
        { "value": "arrow",   "label": "Arrow" },
        { "value": "chevron", "label": "Chevron" }
      ],
      "default": "arrow"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "Arrow shape",
      "options": [
        { "value": "none",   "label": "None" },
        { "value": "circle", "label": "Circle" },
        { "value": "square", "label": "Square" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Tabs style"
    },
    {
      "type": "range",
      "id": "tab_font_size",
      "label": "Tab font size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "tab_font_size_mobile",
      "label": "Tab font size (mobile)",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "tab_padding_v",
      "label": "Tab vertical padding",
      "min": 2,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "tab_padding_h",
      "label": "Tab horizontal padding",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "tabs_gap",
      "label": "Gap between tabs",
      "min": 4,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "color",
      "id": "tab_color",
      "label": "Tab text",
      "default": "#002b36"
    },
    {
      "type": "color",
      "id": "tab_bg_color",
      "label": "Tab background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tab_active_color",
      "label": "Active tab text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tab_bg_active",
      "label": "Active tab background",
      "default": "#002b36"
    },
    {
      "type": "color",
      "id": "tab_hover_color",
      "label": "Hover tab text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tab_bg_hover",
      "label": "Hover tab background",
      "default": "#a8c4b3"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Collection Tabs",
      "blocks": {
        "static-product-card": {
          "type": "_product-card",
          "name": "Product card",
          "static": true,
          "settings": {
            "product_card_gap": 4,
            "inherit_color_scheme": true,
            "color_scheme": "",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "product-card-gallery": {
              "type": "_product-card-gallery",
              "name": "Media",
              "settings": {
                "image_ratio": "adapt",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "product_title": {
              "type": "product-title",
              "name": "Product title",
              "settings": {
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "color": "var(--color-foreground)",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 4,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "price": {
              "type": "price",
              "name": "Price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "h6",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "color": "var(--color-foreground)",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            }
          },
          "block_order": ["product-card-gallery", "product_title", "price"]
        }
      },
      "block_order": []
    }
  ]
}
{% endschema %}

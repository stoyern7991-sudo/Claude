{%- liquid
  assign product_count = section.settings.product_limit | default: 8
  assign collection = collections[section.settings.collection]
-%}

<section class="product-carousel section-padding {{ section.settings.background }}" id="pc-{{ section.id }}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="product-carousel__header reveal">
        <h2 class="product-carousel__heading">{{ section.settings.heading | escape }}</h2>
        {%- if collection != blank and section.settings.show_view_all -%}
          <a href="{{ collection.url }}" class="product-carousel__view-all">
            View All
            {%- render 'icon-arrow-right' -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="carousel-wrapper">
      <div class="product-carousel__track" id="carousel-track-{{ section.id }}">
        {%- if collection != blank -%}
          {%- for product in collection.products limit: product_count -%}
            <div class="product-carousel__item">
              {%- render 'product-card', product: product, show_vendor: section.settings.show_vendor -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..6) -%}
            <div class="product-carousel__item">
              <div class="product-card">
                <div class="skeleton" style="aspect-ratio:3/4; border-radius: var(--radius-lg);"></div>
                <div class="skeleton" style="height:1rem; margin-top:var(--space-3); border-radius:var(--radius-sm);"></div>
                <div class="skeleton" style="height:0.875rem; margin-top:var(--space-2); width:60%; border-radius:var(--radius-sm);"></div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <button
        class="carousel-arrow carousel-arrow--prev"
        aria-label="Previous products"
        data-carousel-prev="{{ section.id }}"
      >
        {%- render 'icon-chevron-left' -%}
      </button>
      <button
        class="carousel-arrow carousel-arrow--next"
        aria-label="Next products"
        data-carousel-next="{{ section.id }}"
      >
        {%- render 'icon-chevron-right' -%}
      </button>
    </div>
  </div>
</section>

<script>
  (function() {
    const track = document.getElementById('carousel-track-{{ section.id }}');
    const prevBtn = document.querySelector('[data-carousel-prev="{{ section.id }}"]');
    const nextBtn = document.querySelector('[data-carousel-next="{{ section.id }}"]');
    if (!track || !prevBtn || !nextBtn) return;

    function scrollBy(dir) {
      const itemWidth = track.querySelector('.product-carousel__item')?.offsetWidth || 300;
      track.scrollBy({ left: dir * (itemWidth + 16), behavior: 'smooth' });
    }

    prevBtn.addEventListener('click', () => scrollBy(-1));
    nextBtn.addEventListener('click', () => scrollBy(1));

    function updateArrows() {
      prevBtn.classList.toggle('is-disabled', track.scrollLeft <= 4);
      nextBtn.classList.toggle('is-disabled', track.scrollLeft + track.offsetWidth >= track.scrollWidth - 4);
    }

    track.addEventListener('scroll', updateArrows, { passive: true });
    updateArrows();
  })();
</script>

{% schema %}
{
  "name": "Product Carousel",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 4,
      "max": 16,
      "step": 2,
      "label": "Max products to show",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' link",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "bg-default", "label": "Default" },
        { "value": "bg-alt", "label": "Warm sand" },
        { "value": "bg-white", "label": "White" }
      ],
      "default": "bg-default"
    }
  ],
  "presets": [
    {
      "name": "Product Carousel"
    }
  ]
}
{% endschema %}

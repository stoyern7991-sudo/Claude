<footer class="site-footer bg-navy">
  <div class="footer__inner container">
    <div class="footer__grid">

      {%- comment -%} Brand column {%- endcomment -%}
      <div class="footer__col footer__col--brand">
        {%- if section.settings.logo != blank -%}
          <a href="{{ routes.root_url }}" class="footer__logo">
            <img
              src="{{ section.settings.logo | image_url: width: 240 }}"
              alt="{{ shop.name }}"
              width="{{ section.settings.logo_width | default: 140 }}"
              loading="lazy"
            >
          </a>
        {%- else -%}
          <a href="{{ routes.root_url }}" class="footer__shop-name">{{ shop.name }}</a>
        {%- endif -%}

        {%- if section.settings.tagline != blank -%}
          <p class="footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}

        <div class="footer__social">
          {%- if section.settings.social_instagram != blank -%}
            <a href="{{ section.settings.social_instagram }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="Instagram">
              {%- render 'icon-instagram' -%}
            </a>
          {%- endif -%}
          {%- if section.settings.social_facebook != blank -%}
            <a href="{{ section.settings.social_facebook }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="Facebook">
              {%- render 'icon-facebook' -%}
            </a>
          {%- endif -%}
          {%- if section.settings.social_tiktok != blank -%}
            <a href="{{ section.settings.social_tiktok }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="TikTok">
              {%- render 'icon-tiktok' -%}
            </a>
          {%- endif -%}
          {%- if section.settings.social_pinterest != blank -%}
            <a href="{{ section.settings.social_pinterest }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="Pinterest">
              {%- render 'icon-pinterest' -%}
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Nav columns {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="footer__col-heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul class="footer__nav-list">
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}" class="footer__nav-link">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- elsif block.type == 'contact' -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="footer__col-heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.address != blank -%}
              <p class="footer__contact-text">{{ block.settings.address | newline_to_br }}</p>
            {%- endif -%}
            {%- if block.settings.phone != blank -%}
              <a href="tel:{{ block.settings.phone }}" class="footer__nav-link">{{ block.settings.phone }}</a>
            {%- endif -%}
            {%- if block.settings.email != blank -%}
              <a href="mailto:{{ block.settings.email }}" class="footer__nav-link">{{ block.settings.email }}</a>
            {%- endif -%}
            {%- if block.settings.hours != blank -%}
              <p class="footer__contact-text" style="margin-top: 1rem;">{{ block.settings.hours | newline_to_br }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <div class="footer__bottom-left">
        <p class="footer__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.
          {%- if section.settings.copyright_text != blank -%}
            {{ section.settings.copyright_text }}
          {%- else -%}
            All rights reserved.
          {%- endif -%}
        </p>
      </div>
      <div class="footer__bottom-right">
        {%- if section.settings.show_payment_icons -%}
          <div class="footer__payment-icons">
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "site-footer-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo (light version)"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Logo width",
      "default": 140
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Coastal lifestyle, curated for you."
    },
    {
      "type": "header",
      "content": "Social media"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "Pinterest URL"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Navigation column",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "main-menu"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact info",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Visit Us"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "default": "211 South Broad St\nEdenton, NC 27932"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        },
        {
          "type": "textarea",
          "id": "hours",
          "label": "Store hours",
          "default": "Mon–Sat: 10am–6pm\nSun: 12pm–5pm"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "link_list",
          "settings": {
            "heading": "Shop",
            "menu": "main-menu"
          }
        },
        {
          "type": "link_list",
          "settings": {
            "heading": "Help",
            "menu": "footer"
          }
        },
        {
          "type": "contact",
          "settings": {
            "heading": "Visit Us"
          }
        }
      ]
    }
  ]
}
{% endschema %}

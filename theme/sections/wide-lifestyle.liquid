{%- style -%}
  .wlife {
    position: relative;
    height: clamp(420px, 60vw, 700px);
    overflow: hidden;
  }
  .wlife__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center {{ section.settings.focal_point | default: '60%' }};
  }
  .wlife__placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, var(--color-navy-mid), var(--color-navy-light), var(--color-sage));
  }
  .wlife::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent {{ section.settings.overlay_start | default: 40 }}%,
      rgba(13, 37, 53, {{ section.settings.overlay_opacity | default: 0.55 }}) 100%
    );
  }
  .wlife__label {
    position: absolute;
    bottom: clamp(1.5rem, 4vw, 2.5rem);
    left: var(--section-padding-x);
    z-index: 2;
    color: #fff;
    max-width: 38ch;
  }
  .wlife__label-eye {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-aqua);
    display: block;
    margin-bottom: 0.6rem;
  }
  .wlife__label p {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.1rem, 2vw, 1.6rem);
    line-height: 1.45;
    margin: 0;
  }
{%- endstyle -%}

<div class="wlife reveal" id="wlife-{{ section.id }}">
  {%- if section.settings.image != blank -%}
    <img
      class="wlife__img"
      src="{{ section.settings.image | image_url: width: 2400 }}"
      alt="{{ section.settings.image.alt | default: section.settings.caption | escape }}"
      loading="lazy"
      width="{{ section.settings.image.width }}"
      height="{{ section.settings.image.height }}"
    >
  {%- else -%}
    <div class="wlife__placeholder"></div>
  {%- endif -%}
  {%- if section.settings.eyebrow != blank or section.settings.caption != blank -%}
    <div class="wlife__label">
      {%- if section.settings.eyebrow != blank -%}
        <span class="wlife__label-eye">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.caption != blank -%}
        <p>{{ section.settings.caption }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Wide Lifestyle Image",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "focal_point",
      "label": "Vertical focal point",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "40%", "label": "Upper" },
        { "value": "60%", "label": "Lower" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "60%"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Location / eyebrow",
      "default": "Outer Banks, NC"
    },
    {
      "type": "textarea",
      "id": "caption",
      "label": "Caption",
      "default": "Where the road ends\nand the good stuff starts."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.55
    },
    {
      "type": "range",
      "id": "overlay_start",
      "label": "Overlay start (%)",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Wide Lifestyle Image"
    }
  ]
}
{% endschema %}

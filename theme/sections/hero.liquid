{%- liquid
  assign section_height = section.settings.height
  assign text_position = section.settings.text_position
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
-%}

<section
  class="hero parallax-wrapper hero--{{ section_height }}"
  id="hero-{{ section.id }}"
  aria-label="{{ section.settings.heading | escape }}"
>
  {%- comment -%} Background image {%- endcomment -%}
  <div class="hero__media parallax-layer" data-parallax-ratio="0.35">
    {%- if section.settings.video != blank -%}
      <video
        class="hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      >
        <source src="{{ section.settings.video }}">
      </video>
    {%- elsif section.settings.image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w"
          >
        {%- endif -%}
        <source
          media="(min-width: 750px)"
          srcset="{{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1800 }} 1800w, {{ section.settings.image | image_url: width: 2400 }} 2400w, {{ section.settings.image | image_url: width: 3200 }} 3200w"
          sizes="100vw"
        >
        <img
          src="{{ section.settings.image | image_url: width: 1800 }}"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          class="hero__img"
          fetchpriority="high"
          loading="eager"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      </picture>
    {%- else -%}
      <div class="hero__placeholder"></div>
    {%- endif -%}
  </div>

  {%- comment -%} Grain texture overlay {%- endcomment -%}
  <div class="hero__grain" aria-hidden="true"></div>

  {%- comment -%} Colour overlay {%- endcomment -%}
  <div
    class="hero__overlay"
    aria-hidden="true"
    style="--overlay-opacity: {{ overlay_opacity }}; background: {{ section.settings.overlay_color }};"
  ></div>

  {%- comment -%} Content {%- endcomment -%}
  <div class="hero__content hero__content--{{ text_position }}">
    <div class="hero__content-inner container">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow label" style="color: {{ section.settings.text_color }}; opacity: 0.8;">
          {{ section.settings.eyebrow | escape }}
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero__heading" style="color: {{ section.settings.text_color }};">
          {{ section.settings.heading }}
        </h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="hero__subheading" style="color: {{ section.settings.text_color }};">
          {{ section.settings.subheading | escape }}
        </p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <div class="hero__cta">
          <a
            href="{{ section.settings.cta_url }}"
            class="btn btn--{{ section.settings.cta_style }}{% if section.settings.cta_style == 'primary' %} btn--ghost{% endif %}"
          >
            {{ section.settings.cta_label | escape }}
          </a>
          {%- if section.settings.cta_2_label != blank -%}
            <a href="{{ section.settings.cta_2_url }}" class="btn btn--ghost">
              {{ section.settings.cta_2_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Wave divider at bottom {%- endcomment -%}
  {%- if section.settings.show_wave -%}
    <div class="hero__wave" aria-hidden="true">
      <svg viewBox="0 0 1440 64" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M0 64L48 58.7C96 53 192 43 288 37.3C384 32 480 32 576 37.3C672 43 768 53 864 58.7C960 64 1056 64 1152 58.7C1248 53 1344 43 1392 37.3L1440 32V64H1392C1344 64 1248 64 1152 64C1056 64 960 64 864 64C768 64 672 64 576 64C480 64 384 64 288 64C192 64 96 64 48 64H0Z" fill="{{ section.settings.wave_color | default: 'var(--color-bg)' }}"/>
      </svg>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image (optional)"
    },
    {
      "type": "text",
      "id": "video",
      "label": "Video URL (mp4, overrides image)"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#0d2535"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 35
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the New Collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "text",
      "id": "cta_2_label",
      "label": "Secondary button label"
    },
    {
      "type": "url",
      "id": "cta_2_url",
      "label": "Secondary button URL"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "Primary button style",
      "options": [
        { "value": "ghost", "label": "Ghost (outline)" },
        { "value": "primary", "label": "Solid white" },
        { "value": "sage", "label": "Sage" }
      ],
      "default": "ghost"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Content position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_wave",
      "label": "Show wave divider at bottom",
      "default": false
    },
    {
      "type": "color",
      "id": "wave_color",
      "label": "Wave fill color",
      "default": "#faf8f5"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "settings": {
        "heading": "Shop the New Collection",
        "cta_label": "Shop Now",
        "height": "full",
        "text_position": "center"
      }
    }
  ]
}
{% endschema %}

<section class="media-text section-padding {{ section.settings.background }}" id="mt-{{ section.id }}">
  <div class="container">
    <div class="media-text__inner media-text__inner--{{ section.settings.layout }}{% if section.settings.full_bleed %} media-text__inner--full-bleed{% endif %}">

      <div class="media-text__media reveal-{{ section.settings.layout == 'image_right' | ternary: 'right', 'left' }}">
        {%- if section.settings.video != blank -%}
          <video
            src="{{ section.settings.video }}"
            autoplay muted loop playsinline
            class="media-text__video"
          ></video>
        {%- elsif section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1000 }}"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            class="media-text__img"
            width="1000"
            height="{{ 1000 | divided_by: section.settings.image.aspect_ratio | ceil }}"
            loading="lazy"
          >
        {%- else -%}
          <div class="skeleton media-text__img-placeholder" style="aspect-ratio:1/1;"></div>
        {%- endif -%}
      </div>

      <div class="media-text__content reveal-{{ section.settings.layout == 'image_right' | ternary: 'left', 'right' }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="section-header__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="media-text__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="media-text__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url }}" class="btn btn--primary" style="margin-top: var(--space-6);">
            {{ section.settings.cta_label | escape }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with Text",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "video",
      "label": "Video URL (mp4, overrides image)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Our Story"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tell your brand story here. Keep it authentic, personal, and brief.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        { "value": "image_left", "label": "Image left" },
        { "value": "image_right", "label": "Image right" }
      ],
      "default": "image_left"
    },
    {
      "type": "checkbox",
      "id": "full_bleed",
      "label": "Full-bleed image (no container)",
      "default": false
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "bg-default", "label": "Default" },
        { "value": "bg-alt", "label": "Warm sand" },
        { "value": "bg-surface", "label": "Sage" },
        { "value": "bg-white", "label": "White" }
      ],
      "default": "bg-default"
    }
  ],
  "presets": [
    {
      "name": "Image with Text"
    }
  ]
}
{% endschema %}

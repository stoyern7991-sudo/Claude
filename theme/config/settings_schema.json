  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Heading Font"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading Font",
        "default": "playfair_display_n4"
      },
      {
        "type": "range",
        "id": "font_heading_scale",
        "label": "Heading Size Scale",
        "min": 75,
        "max": 150,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "header",
        "content": "Body Font"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body Font",
        "default": "dm_sans_n4"
      },
      {
        "type": "range",
        "id": "font_body_scale",
        "label": "Body Size Scale",
        "min": 75,
        "max": 125,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (Dark)",
        "info": "Used on scroll / sticky header"
      },
      {
        "type": "image_picker",
        "id": "logo_light",
        "label": "Logo (Light)",
        "info": "Used on transparent header over hero"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo Width",
        "min": 60,
        "max": 280,
        "step": 10,
        "unit": "px",
        "default": 160
      },
      {
        "type": "link_list",
        "id": "menu",
        "label": "Main Navigation Menu",
        "default": "main-menu"
      },
      {
        "type": "select",
        "id": "sticky_header",
        "label": "Sticky Header",
        "options": [
          { "value": "none", "label": "Not sticky" },
          { "value": "always", "label": "Always sticky" },
          { "value": "scroll-up", "label": "Sticky on scroll up" }
        ],
        "default": "scroll-up"
      },
      {
        "type": "checkbox",
        "id": "transparent_on_home",
        "label": "Transparent header on homepage",
        "default": true
      },
      {
        "type": "text",
        "id": "phone",
        "label": "Phone Number",
        "info": "Displayed in header on desktop"
      }
    ]
  },
  {
    "name": "Footer",
    "settings": [
      {
        "type": "image_picker",
        "id": "footer_logo",
        "label": "Footer Logo",
        "info": "Defaults to main logo if not set"
      },
      {
        "type": "richtext",
        "id": "footer_tagline",
        "label": "Footer Tagline",
        "default": "<p>Coastal lifestyle clothing & accessories for the heart of the coast.</p>"
      },
      {
        "type": "header",
        "content": "Social Links"
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "url",
        "id": "social_pinterest",
        "label": "Pinterest URL"
      },
      {
        "type": "header",
        "content": "Payment Icons"
      },
      {
        "type": "checkbox",
        "id": "show_payment_icons",
        "label": "Show payment icons",
        "default": true
      },
      {
        "type": "text",
        "id": "copyright_text",
        "label": "Copyright Text",
        "default": "Coastal Threads NC"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart Type",
        "options": [
          { "value": "drawer", "label": "Drawer (slide-in)" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_shipping_bar",
        "label": "Show free shipping progress bar",
        "default": true
      },
      {
        "type": "number",
        "id": "cart_shipping_threshold",
        "label": "Free shipping threshold ($)",
        "default": 75
      },
      {
        "type": "text",
        "id": "cart_shipping_message",
        "label": "Free shipping message",
        "default": "You've unlocked free shipping!"
      },
      {
        "type": "text",
        "id": "cart_shipping_progress_message",
        "label": "Shipping progress message",
        "default": "Add [amount] more for free shipping"
      }
    ]
  },
  {
    "name": "Product",
    "settings": [
      {
        "type": "header",
        "content": "Product Cards"
      },
      {
        "type": "checkbox",
        "id": "product_card_show_vendor",
        "label": "Show vendor on product cards",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "product_card_show_rating",
        "label": "Show Judge.me rating on cards",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "product_card_quick_add",
        "label": "Enable quick add button",
        "default": true
      },
      {
        "type": "header",
        "content": "Product Page"
      },
      {
        "type": "checkbox",
        "id": "product_show_vendor",
        "label": "Show vendor",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "product_show_rating",
        "label": "Show Judge.me rating",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "product_show_share",
        "label": "Show share buttons",
        "default": false
      },
      {
        "type": "richtext",
        "id": "product_shipping_text",
        "label": "Shipping & Returns blurb",
        "default": "<p>Free shipping on orders over $75. Free returns within 30 days.</p>"
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "animations_enabled",
        "label": "Enable scroll animations",
        "default": true,
        "info": "Automatically disabled for users who prefer reduced motion"
      },
      {
        "type": "select",
        "id": "animations_intensity",
        "label": "Animation Intensity",
        "options": [
          { "value": "subtle", "label": "Subtle" },
          { "value": "medium", "label": "Medium" },
          { "value": "strong", "label": "Strong" }
        ],
        "default": "medium"
      },
      {
        "type": "checkbox",
        "id": "parallax_enabled",
        "label": "Enable hero parallax effect",
        "default": true
      }
    ]
  },
  {
    "name": "Search",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search_enabled",
        "label": "Enable predictive search",
        "default": true
      },
      {
        "type": "number",
        "id": "predictive_search_limit",
        "label": "Max search results",
        "default": 6
      },
      {
        "type": "checkbox",
        "id": "search_show_collections",
        "label": "Show collections in search results",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "search_show_pages",
        "label": "Show pages in search results",
        "default": true
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Will be scaled down to 32×32px"
      }
    ]
  },
  {
    "name": "Social Sharing",
    "settings": [
      {
        "type": "checkbox",
        "id": "share_facebook",
        "label": "Share on Facebook",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "share_twitter",
        "label": "Share on X (Twitter)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "share_pinterest",
        "label": "Share on Pinterest",
        "default": true
      }
    ]
  },
  {
    "name": "Custom Code",
    "settings": [
      {
        "type": "header",
        "content": "Custom CSS"
      },
      {
        "type": "textarea",
        "id": "custom_css",
        "label": "Custom CSS",
        "info": "Added inside a <style> tag before </head>"
      },
      {
        "type": "header",
        "content": "Custom Scripts"
      },
      {
        "type": "textarea",
        "id": "custom_js",
        "label": "Custom JavaScript",
        "info": "Added before </body>"
      }
    ]
  }
]

<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_navy }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- render 'meta-tags' -%}

    {{ content_for_header }}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400;1,9..40,300&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'animations.css' | asset_url | stylesheet_tag }}

    <style>
      :root {
        --color-bg: {{ settings.color_bg }};
        --color-bg-alt: {{ settings.color_bg_alt }};
        --color-surface: {{ settings.color_surface }};
        --color-navy: {{ settings.color_navy }};
        --color-navy-mid: {{ settings.color_navy_mid }};
        --color-sage: {{ settings.color_sage }};
        --color-sand: {{ settings.color_sand }};
        --color-text: {{ settings.color_text }};
        --color-text-muted: {{ settings.color_text_muted }};
        --color-border: {{ settings.color_border }};
        --color-btn-primary-bg: {{ settings.color_btn_primary_bg }};
        --color-btn-primary-text: {{ settings.color_btn_primary_text }};
        --color-btn-secondary-bg: {{ settings.color_btn_secondary_bg }};
        --color-btn-secondary-text: {{ settings.color_btn_secondary_text }};
        --logo-width: {{ settings.logo_width }}px;
      }
      {%- if settings.animations_enabled == false -%}
        .reveal, .reveal-stagger > *, .reveal-left, .reveal-right, .reveal-scale { opacity: 1 !important; transform: none !important; }
      {%- endif -%}
      {%- if settings.custom_css != blank -%}
        {{ settings.custom_css }}
      {%- endif -%}
    </style>

    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');

      window.Shoreline = window.Shoreline || {};
      window.Shoreline.moneyFormat = {{ shop.money_format | json }};
      window.Shoreline.cartType = {{ settings.cart_type | json }};
      window.Shoreline.shippingThreshold = {{ settings.cart_shipping_threshold | default: 75 | json }};
      window.Shoreline.animations = {{ settings.animations_enabled | default: true | json }};
      window.Shoreline.parallax = {{ settings.parallax_enabled | default: true | json }};
    </script>

    <script>
      (function() {
        function setHeaderHeight() {
          var header = document.querySelector('.site-header');
          if (header) {
            document.documentElement.style.setProperty('--header-height', header.offsetHeight + 'px');
          }
        }
        document.addEventListener('DOMContentLoaded', setHeaderHeight);
        window.addEventListener('resize', setHeaderHeight);
      })();
    </script>
  </head>

  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    <a class="skip-to-content-link" href="#MainContent">Skip to content</a>

    {%- sections 'header-group' -%}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {%- sections 'footer-group' -%}

    {%- render 'cart-drawer' -%}

    <div id="predictive-search-overlay" class="search-overlay" hidden>
      {%- render 'predictive-search-form' -%}
    </div>

    <div id="overlay-backdrop" class="overlay-backdrop" hidden></div>

    <script src="{{ 'utils.js' | asset_url }}" defer></script>
    <script src="{{ 'animations.js' | asset_url }}" defer></script>
    <script src="{{ 'header.js' | asset_url }}" defer></script>
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>
    <script src="{{ 'search.js' | asset_url }}" defer></script>

    {%- if settings.custom_js != blank -%}
      <script>{{ settings.custom_js }}</script>
    {%- endif -%}
  </body>
</html>

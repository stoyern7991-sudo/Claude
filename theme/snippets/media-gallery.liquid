{%- comment -%}
  Product media gallery.
  Desktop: thumbnail strip on the left, main image right.
  Mobile: swipe carousel.
  Accepts: product
{%- endcomment -%}

{%- assign featured = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}

<div class="media-gallery" data-product-id="{{ product.id }}">
  {%- comment -%} Desktop thumbnail strip {%- endcomment -%}
  {%- if product.media.size > 1 -%}
    <div class="media-gallery__thumbs" role="list" aria-label="Product images">
      {%- for media in product.media -%}
        <button
          class="media-gallery__thumb{% if media.id == featured.id %} is-active{% endif %}"
          data-media-id="{{ media.id }}"
          aria-label="View image {{ forloop.index }}"
          role="listitem"
        >
          <img
            src="{{ media.preview_image | image_url: width: 120 }}"
            alt="{{ media.alt | default: product.title | escape }}"
            width="120"
            height="{{ 120 | divided_by: media.preview_image.aspect_ratio | ceil }}"
            loading="{{ forloop.first | ternary: 'eager', 'lazy' }}"
          >
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} Main image viewer {%- endcomment -%}
  <div class="media-gallery__main" id="media-gallery-{{ product.id }}">
    {%- for media in product.media -%}
      <div
        class="media-gallery__slide{% if media.id == featured.id %} is-active{% endif %}"
        data-media-id="{{ media.id }}"
      >
        {%- case media.media_type -%}
          {%- when 'image' -%}
            <img
              src="{{ media | image_url: width: 1200 }}"
              alt="{{ media.alt | default: product.title | escape }}"
              class="media-gallery__img"
              width="1200"
              height="{{ 1200 | divided_by: media.aspect_ratio | ceil }}"
              loading="{{ forloop.first | ternary: 'eager', 'lazy' }}"
            >
          {%- when 'video' -%}
            <video
              src="{{ media.sources.first.url }}"
              class="media-gallery__video"
              autoplay muted loop playsinline
              width="{{ media.preview_image.width }}"
              height="{{ media.preview_image.height }}"
            ></video>
          {%- when 'model' -%}
            <product-model class="media-gallery__model">
              {{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
            </product-model>
          {%- else -%}
            <img
              src="{{ media.preview_image | image_url: width: 1200 }}"
              alt="{{ media.alt | default: product.title | escape }}"
              class="media-gallery__img"
              loading="lazy"
            >
        {%- endcase -%}
      </div>
    {%- endfor -%}

    {%- comment -%} Mobile swipe nav dots {%- endcomment -%}
    {%- if product.media.size > 1 -%}
      <div class="media-gallery__dots" aria-hidden="true">
        {%- for media in product.media -%}
          <span class="media-gallery__dot{% if media.id == featured.id %} is-active{% endif %}" data-media-id="{{ media.id }}"></span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<div id="cart-drawer" class="cart-drawer" data-drawer hidden aria-hidden="true">
  <div class="cart-drawer__panel">
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">Your Cart</h2>
      <button class="cart-drawer__close" data-close-cart aria-label="Close cart">
        {%- render 'icon-close' -%}
      </button>
    </div>

    {%- if settings.free_shipping_threshold > 0 -%}
      <div class="cart-drawer__shipping-bar" id="shipping-bar">
        <div class="shipping-bar__track">
          <div class="shipping-bar__fill" id="shipping-bar-fill"></div>
        </div>
        <p class="shipping-bar__text" id="shipping-bar-text"></p>
      </div>
    {%- endif -%}

    <div class="cart-drawer__body" id="cart-drawer-body">
      {%- if cart.item_count == 0 -%}
        <div class="cart-drawer__empty">
          <p class="cart-drawer__empty-text">Your cart is empty.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Shop Now</a>
        </div>
      {%- else -%}
        <ul class="cart-items" id="cart-items-list">
          {%- for item in cart.items -%}
            <li class="cart-item" data-cart-item-key="{{ item.key }}">
              <a href="{{ item.url }}" class="cart-item__media">
                <img
                  src="{{ item.image | image_url: width: 160 }}"
                  alt="{{ item.title | escape }}"
                  width="80"
                  loading="lazy"
                >
              </a>
              <div class="cart-item__info">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product_title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-item__variant">{{ item.variant_title }}</p>
                {%- endunless -%}
                <div class="cart-item__price-row">
                  <span class="price">{{ item.final_line_price | money }}</span>
                </div>
                <div class="cart-item__actions">
                  <div class="qty-selector qty-selector--sm">
                    <button class="qty-selector__btn" data-cart-qty-change="{{ item.key }}" data-delta="-1" aria-label="Decrease">−</button>
                    <input class="qty-selector__input" type="number" value="{{ item.quantity }}" min="0" data-cart-qty-input="{{ item.key }}" aria-label="Quantity">
                    <button class="qty-selector__btn" data-cart-qty-change="{{ item.key }}" data-delta="1" aria-label="Increase">+</button>
                  </div>
                  <button class="cart-item__remove" data-cart-remove="{{ item.key }}" aria-label="Remove {{ item.title | escape }}">
                    Remove
                  </button>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="cart-drawer__footer" id="cart-drawer-footer">
      <div class="cart-drawer__subtotal">
        <span>Subtotal</span>
        <span class="price" id="cart-subtotal">{{ cart.total_price | money }}</span>
      </div>
      <p class="cart-drawer__tax-note">Taxes and shipping calculated at checkout.</p>
      <a href="{{ routes.checkout }}" class="btn btn--primary btn--full cart-drawer__checkout">
        Checkout
      </a>
      <a href="{{ routes.cart_url }}" class="btn btn--secondary btn--full cart-drawer__view-cart">
        View Cart
      </a>
    </div>
  </div>
</div>

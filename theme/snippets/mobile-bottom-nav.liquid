<nav class="mobile-bottom-nav" aria-label="Mobile navigation">

  <a
    href="{{ routes.root_url }}"
    class="mbn__item{% if request.page_type == 'index' %} is-active{% endif %}"
    aria-label="Home"
  >
    {%- render 'icon-home' -%}
    <span>Home</span>
  </a>

  <button class="mbn__item" data-open-search aria-label="Search">
    {%- render 'icon-search' -%}
    <span>Search</span>
  </button>

  <button class="mbn__item" data-open-nav aria-label="Shop">
    {%- render 'icon-grid' -%}
    <span>Shop</span>
  </button>

  <a
    href="{{ routes.account_url }}"
    class="mbn__item{% if request.page_type == 'customers/login' or request.page_type == 'customers/account' %} is-active{% endif %}"
    aria-label="Account"
  >
    {%- render 'icon-account' -%}
    <span>Account</span>
  </a>

  <button class="mbn__item" data-open-cart aria-label="Cart">
    <div class="mbn__cart-wrap">
      {%- render 'icon-cart' -%}
      {%- if cart.item_count > 0 -%}
        <span class="mbn__cart-badge" aria-label="{{ cart.item_count }} items in cart">{{ cart.item_count }}</span>
      {%- endif -%}
    </div>
    <span>Cart</span>
  </button>

</nav>

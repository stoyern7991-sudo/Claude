{%- comment -%}
  Product card snippet — Clicks-style minimal.
  Accepts: product, show_vendor, show_rating, eager
{%- endcomment -%}

{%- style -%}
  .product-card {
    border-radius: 0;
    background: var(--color-bg);
    box-shadow: none;
  }
  .product-card:hover {
    transform: none;
    box-shadow: none;
  }
  .product-card__media {
    background: var(--color-cream-mid);
  }
  .product-card__img--primary {
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease;
  }
  .product-card--has-hover:hover .product-card__img--primary {
    transform: none;
    opacity: 0;
  }
  .product-card:not(.product-card--has-hover):hover .product-card__img--primary {
    transform: scale(1.04);
  }
  .product-card__info {
    padding: 1rem 0.875rem 1.25rem;
    gap: 0.3rem;
  }
  .product-card__title {
    font-size: 0.82rem;
    font-weight: 300;
    color: var(--color-ink);
    letter-spacing: 0.01em;
  }
  .product-card__title-link:hover {
    color: var(--color-navy);
  }
  .product-card__vendor {
    font-size: 0.62rem;
    letter-spacing: 0.15em;
  }
{%- endstyle -%}

{%- liquid
  assign featured_img = product.featured_image
  assign second_img = product.images[1]
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
  assign sold_out = true
  if product.available
    assign sold_out = false
  endif
-%}

<article
  class="product-card{% if second_img != blank %} product-card--has-hover{% endif %}"
  data-product-id="{{ product.id }}"
>
  <a href="{{ product.url }}" class="product-card__media-link" tabindex="-1" aria-hidden="true">
    <div class="product-card__media">
      {%- if featured_img != blank -%}
        <img
          src="{{ featured_img | image_url: width: 600 }}"
          alt="{{ featured_img.alt | default: product.title | escape }}"
          class="product-card__img product-card__img--primary"
          width="600"
          height="{{ 600 | divided_by: featured_img.aspect_ratio | ceil }}"
          loading="{{ eager | default: false | ternary: 'eager', 'lazy' }}"
        >
        {%- if second_img != blank -%}
          <img
            src="{{ second_img | image_url: width: 600 }}"
            alt="{{ second_img.alt | default: product.title | escape }}"
            class="product-card__img product-card__img--secondary"
            width="600"
            height="{{ 600 | divided_by: second_img.aspect_ratio | ceil }}"
            loading="lazy"
          >
        {%- endif -%}
      {%- else -%}
        <div class="product-card__img-placeholder skeleton" style="aspect-ratio: 3/4;"></div>
      {%- endif -%}

      <div class="product-card__badges">
        {%- if sold_out -%}
          <span class="badge badge--sold-out">Sold Out</span>
        {%- elsif on_sale -%}
          {%- assign savings = product.compare_at_price | minus: product.price -%}
          {%- assign pct = savings | times: 100 | divided_by: product.compare_at_price -%}
          <span class="badge badge--sale">-{{ pct }}%</span>
        {%- elsif product.tags contains 'new' or product.tags contains 'New' -%}
          <span class="badge badge--new">New</span>
        {%- endif -%}
      </div>

      {%- unless sold_out -%}
        <div class="product-card__quick-add">
          {%- if product.variants.size == 1 -%}
            <button
              class="btn btn--primary btn--sm product-card__quick-add-btn"
              data-quick-add="{{ product.variants.first.id }}"
              aria-label="Quick add {{ product.title | escape }}"
            >
              Add to Cart
            </button>
          {%- else -%}
            <a href="{{ product.url }}" class="btn btn--primary btn--sm">Select Options</a>
          {%- endif -%}
        </div>
      {%- endunless -%}
    </div>
  </a>

  <div class="product-card__info">
    {%- if show_vendor and product.vendor != blank -%}
      <p class="product-card__vendor label">{{ product.vendor }}</p>
    {%- endif -%}

    {%- if show_rating -%}
      {%- render 'judgeme-stars', product: product -%}
    {%- endif -%}

    <h3 class="product-card__title">
      <a href="{{ product.url }}" class="product-card__title-link">{{ product.title }}</a>
    </h3>

    {%- render 'price', product: product -%}

    {%- assign color_option = product.options_with_values | where: 'name', 'Color' | first -%}
    {%- unless color_option == blank -%}
      <div class="product-card__swatches">
        {%- for value in color_option.values limit: 5 -%}
          {%- render 'swatch', value: value, selected: forloop.first -%}
        {%- endfor -%}
        {%- if color_option.values.size > 5 -%}
          <span class="product-card__swatch-more">+{{ color_option.values.size | minus: 5 }}</span>
        {%- endif -%}
      </div>
    {%- endunless -%}
  </div>
</article>

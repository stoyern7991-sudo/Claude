{%- comment -%}
  Variant picker — swatches for color, dropdowns for other options.
  Accepts: product, form_id
{%- endcomment -%}

{%- unless product.has_only_default_variant -%}
  <div class="variant-picker" data-product-id="{{ product.id }}">
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign option_name = option.name | downcase
        assign is_color = false
        if option_name == 'color' or option_name == 'colour'
          assign is_color = true
        endif
      -%}
      <div class="variant-picker__option" data-option-index="{{ forloop.index0 }}">
        <div class="variant-picker__label-row">
          <span class="variant-picker__label">{{ option.name }}</span>
          {%- if is_color -%}
            <span class="variant-picker__selected-value" data-option-selected="{{ forloop.index0 }}">
              {{ option.selected_value }}
            </span>
          {%- endif -%}
        </div>

        {%- if is_color -%}
          <div class="variant-picker__swatches" role="radiogroup" aria-label="{{ option.name }}">
            {%- for value in option.values -%}
              {%- liquid
                assign variant_for_option = product.variants | where: 'option1', value | first
                if option.position == 2
                  assign variant_for_option = product.variants | where: 'option2', value | first
                elsif option.position == 3
                  assign variant_for_option = product.variants | where: 'option3', value | first
                endif
                assign available = false
                if variant_for_option.available
                  assign available = true
                endif
              -%}
              <label
                class="swatch{% if value == option.selected_value %} is-selected{% endif %}{% unless available %} is-sold-out{% endunless %}"
                title="{{ value | escape }}"
                aria-label="{{ value | escape }}{% unless available %} (Sold Out){% endunless %}"
              >
                <input
                  type="radio"
                  class="visually-hidden variant-picker__radio"
                  form="{{ form_id }}"
                  name="{{ option.name }}"
                  value="{{ value | escape }}"
                  {% if value == option.selected_value %}checked{% endif %}
                >
                <span
                  class="swatch__inner"
                  style="background-color: {{ value | handleize | prepend: '#' }};"
                  aria-hidden="true"
                ></span>
              </label>
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="variant-picker__dropdown-wrapper">
            <select
              class="form-select variant-picker__select"
              form="{{ form_id }}"
              name="{{ option.name }}"
              aria-label="{{ option.name }}"
            >
              {%- for value in option.values -%}
                <option
                  value="{{ value | escape }}"
                  {% if value == option.selected_value %}selected{% endif %}
                >
                  {{ value | escape }}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}

    <input
      type="hidden"
      form="{{ form_id }}"
      name="id"
      class="variant-picker__variant-id"
      value="{{ product.selected_or_first_available_variant.id }}"
    >
  </div>
{%- else -%}
  <input type="hidden" name="id" form="{{ form_id }}" value="{{ product.variants.first.id }}">
{%- endunless -%}
